# Backend REST API this app reads from. See src/lib/api.ts.
VITE_API_URL=http://localhost:4000

# Module Federation remote entry URLs (see vite.config.ts and ../docs/module-federation.md).
# Point these at the deployed dashboard/wizard remotes' remoteEntry.js for a given environment.
# Unset, they default to this repo's local dev ports.
VITE_DASHBOARD_REMOTE_URL=http://localhost:5174/remoteEntry.js
VITE_WIZARD_REMOTE_URL=http://localhost:5175/remoteEntry.js

# Direct Soroban RPC access — used for direct-chain reads (src/lib/soroban.ts) and by the Local
# Indexer (src/lib/localIndexer, src/workers/indexer.worker.ts). Defaults match Testnet if unset.
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
VITE_PACTUM_CONTRACT_ID=CBADTVTJ6IN332HIKZ7LWUYMYTLPZYCEBV3X2HS47VHR5UDBHQ3GAA7E
VITE_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Local Indexer polling (see src/context/IndexerModeContext.tsx). Poll interval matches the
# backend indexer's default (INDEXER_POLL_INTERVAL_MS); lookback ledgers is how far back a
# freshly-enabled Local Indexer looks when it has no stored cursor yet (~1 day at 5s/ledger),
# bounded by whatever the RPC provider actually retains.
VITE_LOCAL_INDEXER_POLL_INTERVAL_MS=15000
VITE_LOCAL_INDEXER_LOOKBACK_LEDGERS=17280

# Web3Auth social login (Issue #214). Create a client at https://dashboard.web3auth.io
# (Sapphire Devnet for Testnet demos). Without this, Freighter/Albedo/Ledger still work;
# the "Login with Google" button shows a configuration error instead of opening the modal.
VITE_WEB3AUTH_CLIENT_ID=
# Optional: sapphire_mainnet | sapphire_devnet (default)
VITE_WEB3AUTH_NETWORK=sapphire_devnet

# Frontend error monitoring & session tracing via Sentry (Issue #210).
# Leave VITE_SENTRY_DSN empty in development/CI to keep Sentry disabled (no-op);
# set it to a real project DSN in production deployments to enable crash reporting,
# React error boundary capture, unhandled promise rejection capture and tracing.
# Sensitive data (Stellar wallet/contract addresses, transaction/commitment hashes)
# is scrubbed before any event leaves the browser.
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# Optional release tag, e.g. the git SHA or a semver tag (defaults to none).
# VITE_SENTRY_RELEASE=
